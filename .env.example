# Postgres (Neon, via Vercel Marketplace or manual provisioning)
DATABASE_URL=

# Clerk (via Vercel Marketplace or clerk.com dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk webhook (Dashboard > Webhooks > add endpoint at /api/webhooks/clerk,
# subscribed to user.deleted) — needed for account-deletion cleanup
CLERK_WEBHOOK_SIGNING_SECRET=

# Spotify — Client Credentials flow (search/submission, app-level)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Spotify — Authorization Code flow (host playlist export)
# Must be registered in the Spotify Developer Dashboard's redirect URIs.
# Spotify requires HTTPS except for the literal loopback IP (not "localhost").
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Random secret used to sign the guest session cookie
GUEST_SESSION_SECRET=
